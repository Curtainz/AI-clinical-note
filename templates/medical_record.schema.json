{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medical record shape reference; semantic/source checks remain necessary",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_features", "diagnostic_discussion", "plan", "evidence", "review_items"],
  "properties": {
    "case_features": {"type": "string", "minLength": 1},
    "diagnostic_discussion": {"type": "string", "minLength": 1},
    "plan": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "source_ids", "kind"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "kind": {"enum": ["fact", "inference"]}
        }
      }
    },
    "review_items": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
